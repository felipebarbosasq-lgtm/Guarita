{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true
  },
  "include": ["./**/*.ts", "../src/lib/types.ts", "../src/lib/sync.ts", "../src/lib/dominio.ts", "../src/lib/seed.ts", "../src/lib/format.ts"]
}
