# Guarita Imobiliária: variáveis de ambiente (exemplo, sem valores reais)
# No Netlify: Site configuration > Environment variables. Nunca coloque senhas neste arquivo.

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública "anon" (pode ficar no navegador: o banco só permite leitura de anúncios publicados).
SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Bucket das fotos (criado por supabase/schema.sql)
SUPABASE_BUCKET=imoveis

# Endereço final do site, sem barra no fim (usado no sitemap, robots.txt e links canônicos)
SITE_URL=https://www.seudominio.com.br

# NÃO É NECESSÁRIA e NUNCA deve ir para o navegador: a chave "service_role" do Supabase.
# O site não usa essa chave. Se algum dia precisar dela, guarde apenas no Netlify, nunca no código.
