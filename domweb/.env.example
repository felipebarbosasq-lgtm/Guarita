# DOM Web: variáveis de ambiente (cadastre no Netlify > Site configuration > Environment variables)
# Nunca coloque valores reais neste arquivo.

# Banco de dados (Supabase > Project settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site (usado nos links que a IA envia)
SITE_URL=

# WhatsApp oficial (Meta Cloud API) — opcional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_STATUS=

# IA do atendente (Claude) — opcional
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
